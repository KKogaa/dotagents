{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Source of truth for personal, machine-wide agent config.
  // Edit .rulesync/**, then run `rulesync generate` from this directory.
  "global": true,
  "targets": ["claudecode", "copilotcli", "opencode"],
  "features": ["rules", "subagents", "skills"],
  // Never sweep ~/.claude/skills or ~/.agents/skills: other installers (jelou, azure, claude.ai sync) live there.
  "delete": false,
  "verbose": false,
  "silent": false,
  "sources": [
    {
      "source": "nextlevelbuilder/ui-ux-pro-max-skill",
      "skills": [
        "design",
        "design-system"
      ],
      "ref": "v2.15.0",
      "path": ".claude/skills"
    },
    {
      "source": "cursor/plugins",
      "skills": [
        "sharpen",
        "reframe",
        "why",
        "architect",
        "blast-radius",
        "tdd",
        "correct",
        "unslop",
        "typescript-best-practices"
      ],
      "path": "pstack/skills"
    },
    {
      "source": "mattpocock/skills",
      "skills": [
        "domain-modeling",
        "grill-with-docs",
        "codebase-design",
        "improve-codebase-architecture"
      ],
      "path": "skills/engineering"
    }
  ]
}
